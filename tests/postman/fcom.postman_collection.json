  "item": [

    {
      "name": "0. Auth Setup — Login seed users",
      "description": "Run first to populate tokens for all other test folders.",
      "item": [
        {
          "name": "Login alice",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nickname\":\"alice\",\"password\":\"{{seed_password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('alice login ok', () => pm.expect(r.ok).to.be.true);",
            "if (r.ok && r.token) pm.collectionVariables.set('alice_token', r.token);"
          ]}}]
        },
        {
          "name": "Login bob",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nickname\":\"bob\",\"password\":\"{{seed_password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
