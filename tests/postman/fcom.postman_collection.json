    {
      "name": "2. OTP Verification",
      "item": [
        {
          "name": "O-01 Correct dev OTP → ok:true",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/verify-phone",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\":\"{{new_phone}}\",\"code\":\"{{dev_otp}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('O-01 ok', () => pm.expect(r.ok).to.be.true);",
            "pm.test('O-01 HTTP 200', () => pm.expect(pm.response.code).to.equal(200));"
          ]}}]
        },
        {
          "name": "O-02 Dev universal bypass code 000000",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/verify-phone",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\":\"{{new_phone}}\",\"code\":\"000000\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('O-02 bypass code accepted or already verified', () => {",
            "  pm.expect(r.ok === true || r.error === 'otp_not_found_or_expired').to.be.true;",
            "});"
          ]}}]
        },
        {
          "name": "O-03 Wrong code → invalid_code + attemptsLeft",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/verify-phone",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\":\"+79001000004\",\"code\":\"999999\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('O-03 invalid_code or expired', () => {",
            "  pm.expect(['invalid_code','otp_not_found_or_expired']).to.include(r.error);",
            "});",
            "if (r.error === 'invalid_code') {",
            "  pm.test('O-03 attemptsLeft is number', () => pm.expect(r.attemptsLeft).to.be.a('number'));",
            "}"
          ]}}]
        },
        {
          "name": "O-07 Unknown phone → user_not_found",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/verify-phone",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\":\"+70000000000\",\"code\":\"123456\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('O-07 user_not_found', () => pm.expect(r.ok).to.be.false);",
            "pm.test('O-07 HTTP 404', () => pm.expect(pm.response.code).to.equal(404));"
          ]}}]
        },
        {
          "name": "O-11 Resend OTP",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/resend-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phone\":\"+79001000004\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
