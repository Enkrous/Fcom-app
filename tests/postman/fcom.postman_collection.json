    {
      "name": "3. Set Password",
      "item": [
        {
          "name": "P-01 Set password with reg token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/set-password",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{reg_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"password\":\"{{seed_password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('P-01 ok', () => pm.expect(r.ok).to.be.true);",
            "pm.test('P-01 HTTP 200', () => pm.expect(pm.response.code).to.equal(200));"
          ]}}]
        },
        {
          "name": "P-02 No token → unauthorized",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/set-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"password\":\"{{seed_password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
