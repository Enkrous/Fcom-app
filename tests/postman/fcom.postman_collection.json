    {
      "name": "6. Messages",
      "item": [
        {
          "name": "M-01 Send message alice → bob",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/messages",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{alice_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"toId\":\"{{bob_id}}\",\"text\":\"Привет из Postman!\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('M-01 ok', () => pm.expect(r.ok).to.be.true);",
            "pm.test('M-01 message.fromId is alice', () => pm.expect(r.message.fromId).to.equal(pm.collectionVariables.get('alice_id')));",
            "pm.test('M-01 message.toId is bob', () => pm.expect(r.message.toId).to.equal(pm.collectionVariables.get('bob_id')));",
            "pm.test('M-01 readAt is null', () => pm.expect(r.message.readAt).to.be.null);",
            "pm.test('M-01 no fromId spoofing', () => pm.expect(r.message.fromId).not.to.equal(pm.collectionVariables.get('bob_id')));"
          ]}}]
        },
        {
          "name": "M-02 Get messages alice↔bob",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/messages?partnerId={{bob_id}}",
              "query": [{ "key": "partnerId", "value": "{{bob_id}}" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{alice_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('M-02 ok', () => pm.expect(r.ok).to.be.true);",
            "pm.test('M-02 messages is array', () => pm.expect(r.messages).to.be.an('array'));",
            "pm.test('M-02 messages not empty', () => pm.expect(r.messages.length).to.be.above(0));",
            "pm.test('M-02 each message has fromId/toId', () => {",
            "  r.messages.forEach(m => {",
            "    const aliceId = pm.collectionVariables.get('alice_id');",
            "    const bobId = pm.collectionVariables.get('bob_id');",
            "    pm.expect([m.fromId, m.toId]).to.include(aliceId);",
            "    pm.expect([m.fromId, m.toId]).to.include(bobId);",
            "  });",
            "});",
            "pm.test('M-02 sorted ascending', () => {",
            "  const msgs = r.messages;",
            "  for (let i = 1; i < msgs.length; i++) {",
            "    pm.expect(new Date(msgs[i].time) >= new Date(msgs[i-1].time)).to.be.true;",
            "  }",
            "});"
          ]}}]
        },
        {
          "name": "M-03 Empty text → text_required",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/messages",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{alice_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"toId\":\"{{bob_id}}\",\"text\":\"\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('M-03 text_required', () => pm.expect(r.error).to.equal('text_required'));"
          ]}}]
        },
        {
          "name": "M-04 No JWT → unauthorized",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/messages",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"toId\":\"{{bob_id}}\",\"text\":\"Hi\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('M-04 unauthorized', () => pm.expect(r.ok).to.be.false);",
            "pm.test('M-04 HTTP 401', () => pm.expect(pm.response.code).to.equal(401));"
          ]}}]
        },
        {
          "name": "M-07 Cross-school message → cross_school_forbidden",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/messages",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{alice_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"toId\":\"{{frank_id}}\",\"text\":\"Hello from other school\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('M-07 cross_school_forbidden', () => pm.expect(r.ok).to.be.false);"
          ]}}]
        }
      ]
    },

