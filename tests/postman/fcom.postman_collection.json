    {
      "name": "1. Registration",
      "item": [
        {
          "name": "R-01 Happy path — without phone",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"fullName\":\"Тестов Тест Тестович\",\"school\":\"Школа №99\",\"grade\":\"9А\",\"nickname\":\"testuser1\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('R-01 ok', () => pm.expect(r.ok).to.be.true);",
            "pm.test('R-01 user has id', () => pm.expect(r.user).to.have.property('id'));",
            "pm.test('R-01 status pending', () => pm.expect(r.user.status).to.equal('pending'));",
            "pm.test('R-01 token issued', () => pm.expect(r.token).to.be.a('string'));",
            "pm.test('R-01 cred is 0', () => pm.expect(Number(r.user.cred)).to.equal(0));",
            "pm.test('R-01 phoneVerified false', () => pm.expect(r.user.phoneVerified).to.be.false);",
            "if (r.user) pm.collectionVariables.set('new_user_id', r.user.id);",
            "if (r.token) pm.collectionVariables.set('reg_token', r.token);"
          ]}}]
        },
        {
          "name": "R-02 Happy path — with phone (dev mode OTP)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"fullName\":\"Звонков Зинаида Зиновьевна\",\"school\":\"Школа №88\",\"grade\":\"10Б\",\"nickname\":\"zvonkova\",\"phone\":\"{{new_phone}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('R-02 ok', () => pm.expect(r.ok).to.be.true);",
            "pm.test('R-02 _devOtp present in dev mode', () => pm.expect(r._devOtp).to.be.a('string'));",
            "pm.test('R-02 _devOtp is 6 digits', () => pm.expect(r._devOtp).to.match(/^\\d{6}$/));",
            "pm.test('R-02 phoneVerified false initially', () => pm.expect(r.user.phoneVerified).to.be.false);",
            "if (r._devOtp) pm.collectionVariables.set('dev_otp', r._devOtp);"
          ]}}]
        },
        {
          "name": "R-03 First user in new school → auto-approved",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"fullName\":\"Первый Пользователь Новой Школы\",\"school\":\"Уникальная Школа №777\",\"grade\":\"11А\",\"nickname\":\"firstschool777\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
