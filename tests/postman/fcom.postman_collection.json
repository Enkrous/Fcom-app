    {
      "name": "5. Approve / Reject",
      "item": [
        {
          "name": "A-01 Approved user approves pending",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/approve",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{alice_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"userId\":\"{{dave_id}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('A-01 ok', () => pm.expect(r.ok).to.be.true);",
