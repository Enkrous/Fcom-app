            "pm.test('S-15 no phone in response', () => pm.expect(r.user.phone).to.be.undefined);",
            "pm.test('S-15 no phoneVerified in response', () => pm.expect(r.user.phoneVerified).to.be.undefined);"
          ]}}]
        }
      ]
