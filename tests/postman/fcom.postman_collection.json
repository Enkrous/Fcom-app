{
  "info": {
    "_postman_id": "fcom-backend-tests-v1",
    "name": "Fcom Backend Tests",
    "description": "Full test suite for Fcom / Кредо backend — Supabase Edge Functions.\n\nPrerequisites:\n1. Set the `base_url` environment variable.\n2. Apply all 19 migrations + seed.sql.\n3. Leave SMS_API_URL empty (dev OTP mode).\n4. Run folders in order: Auth → Registration → OTP → Password → Login → Approve → Messages → Rate → Security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",    "value": "https://vzjlhiqvfgrrlfdgyebx.supabase.co/functions/v1" },
    { "key": "alice_token", "value": "" },
    { "key": "bob_token",   "value": "" },
    { "key": "carol_token", "value": "" },
    { "key": "reg_token",   "value": "" },
    { "key": "seed_password", "value": "testpass" },
    { "key": "new_user_id", "value": "" },
    { "key": "new_phone",   "value": "+79009876543" },
    { "key": "dev_otp",     "value": "" },
    { "key": "alice_id",    "value": "00000000-0000-0000-0000-000000000001" },
    { "key": "bob_id",      "value": "00000000-0000-0000-0000-000000000002" },
    { "key": "carol_id",    "value": "00000000-0000-0000-0000-000000000003" },
    { "key": "dave_id",     "value": "00000000-0000-0000-0000-000000000004" },
    { "key": "eve_id",      "value": "00000000-0000-0000-0000-000000000005" },
