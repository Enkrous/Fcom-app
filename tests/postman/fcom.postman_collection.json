    {
      "name": "8. Security",
      "item": [
        {
          "name": "S-01 No auth header → 401",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users",
            "header": []
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('S-01 unauthorized', () => pm.expect(r.ok).to.be.false);",
            "pm.test('S-01 HTTP 401', () => pm.expect(pm.response.code).to.equal(401));"
          ]}}]
        },
        {
          "name": "S-03 Malformed JWT → 401",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users",
            "header": [{ "key": "Authorization", "value": "Bearer thisisnot.a.jwttoken" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('S-03 unauthorized', () => pm.expect(r.ok).to.be.false);",
            "pm.test('S-03 HTTP 401', () => pm.expect(pm.response.code).to.equal(401));"
          ]}}]
        },
        {
          "name": "S-05 Expired JWT → 401",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users",
            "header": [{
              "key": "Authorization",
              "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0IiwiZXhwIjoxNjAwMDAwMDAwfQ.EXPIRED_SIGNATURE"
            }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('S-05 unauthorized (expired token)', () => pm.expect(r.ok).to.be.false);",
            "pm.test('S-05 HTTP 401', () => pm.expect(pm.response.code).to.equal(401));"
          ]}}]
        },
        {
          "name": "S-06 Logout revokes token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{alice_token}}" }]
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "const r = pm.response.json();",
              "pm.test('S-06 logout ok', () => pm.expect(r.ok).to.be.true);"
            ]}},
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('revoked_token', pm.collectionVariables.get('alice_token'));"
            ]}}
          ]
        },
        {
          "name": "S-06b Revoked token rejected → 401",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{revoked_token}}" }]
          },
          "variable": [{ "key": "revoked_token", "value": "" }],
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('S-06b revoked token rejected', () => pm.expect(r.ok).to.be.false);",
            "pm.test('S-06b HTTP 401', () => pm.expect(pm.response.code).to.equal(401));"
          ]}}]
        },
        {
          "name": "S-15 passwordHash not in login response",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nickname\":\"bob\",\"password\":\"{{seed_password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
