              "pm.test('SC-07 missing target has no outgoing block', () => { pm.expect(r.targetId).to.equal(pm.collectionVariables.get('contract_missing_id')); pm.expect(r.blocks.some(block => block.blockedId === r.targetId)).to.be.false; });"
