        "method": "GET",
        "url": "{{base_url}}/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contract_disposable_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "function abortRequest(message) {",
              "  pm.request.url.update('http://127.0.0.1:1/fcom-test-blocked');",
              "  if (pm.execution && typeof pm.execution.skipRequest === 'function') pm.execution.skipRequest();",
              "  throw new Error(message);",
              "}",
              "const capturedToken = pm.collectionVariables.get('contract_disposable_token');",
              "if (!capturedToken) abortRequest('Run this collection in order; no token was captured by its own setup.');",
              "pm.request.headers.upsert({key:'Authorization',value:'Bearer ' + capturedToken});",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('SC-09 HTTP 200 / ok', () => { pm.expect(pm.response.code).to.equal(200); pm.expect(r.ok).to.be.true; });",
              "function assertCredo(user) {",
              "  pm.expect(user.cred).to.be.a('number');",
              "  pm.expect(user.credLevel).to.be.an('object');",
              "  pm.expect(user.credLevel.name).to.be.a('string').and.not.empty;",
              "  pm.expect(user.credLevel.min).to.be.a('number');",
              "  pm.expect(user.credLevel.max === null || typeof user.credLevel.max === 'number').to.be.true;",
              "  pm.expect(['novice','known','trusted','own']).to.include(user.credLevel.css);",
              "  pm.expect(user.credProgress).to.be.a('number').and.within(0, 1);",
              "}",
              "pm.test('SC-09 freshly created account', () => { pm.expect(r.user.id).to.equal(pm.collectionVariables.get('contract_disposable_id')); pm.expect(r.user.nickname).to.equal(pm.collectionVariables.get('contract_disposable_nickname')); pm.expect(r.user.fullName).to.equal(pm.collectionVariables.get('contract_disposable_name')); pm.expect(r.user.status).to.equal('pending'); assertCredo(r.user); });",
              "if (r.ok && r.user.id === pm.collectionVariables.get('contract_disposable_id') && r.user.nickname === pm.collectionVariables.get('contract_disposable_nickname')) pm.collectionVariables.set('contract_disposable_verified', r.user.id);"
            ]
          }
        }
      ]
