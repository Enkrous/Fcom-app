            "key": "Authorization",
            "value": "Bearer {{contract_disposable_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"password\":\"{{contract_disposable_password}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "function abortRequest(message) {",
              "  pm.request.url.update('http://127.0.0.1:1/fcom-test-blocked');",
              "  if (pm.execution && typeof pm.execution.skipRequest === 'function') pm.execution.skipRequest();",
              "  throw new Error(message);",
              "}",
              "const capturedToken = pm.collectionVariables.get('contract_disposable_token');",
              "if (!capturedToken) abortRequest('Run this collection in order; no token was captured by its own setup.');",
              "pm.request.headers.upsert({key:'Authorization',value:'Bearer ' + capturedToken});",
              "const createdId = pm.collectionVariables.get('contract_disposable_id');",
              "const nickname = pm.collectionVariables.get('contract_disposable_nickname');",
              "if (pm.collectionVariables.get('contract_disposable_verified') !== createdId || !/^postman(?:_[a-f0-9]{12})?_delete_[a-f0-9]+$/.test(nickname || '')) abortRequest('Deletion requires the freshly registered and /me-verified disposable account.');",
              "if (!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(createdId || '') || /^00000000-0000-0000-0000-/.test(createdId)) abortRequest('A seed or invalid user id cannot be deleted.');",
              "const seededIds = ['alice_id','bob_id','carol_id','dave_id','eve_id','frank_id','grace_id'].map(key => pm.variables.get(key));",
              "if (seededIds.includes(createdId) || createdId === pm.collectionVariables.get('contract_caller_id')) abortRequest('A preexisting test account cannot be deleted.');",
              "const jwtBuffer = require('buffer').Buffer;",
              "let subject; try { subject = JSON.parse(jwtBuffer.from(capturedToken.split('.')[1], 'base64').toString('utf8')).sub; } catch { abortRequest('Disposable token has an invalid payload.'); }",
              "if (subject !== createdId) abortRequest('Disposable token subject must match the freshly created account.');",
              "})();"
            ]
          }
        },
