              "const suffix = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '');",
              "const values = { contract_disposable_nickname: (pm.variables.get('fcom_fixture_prefix') || 'postman') + '_delete_' + suffix, contract_disposable_name: 'Postman Delete ' + (pm.variables.get('fcom_fixture_prefix') || 'local') + ' ' + suffix, contract_disposable_school: 'Postman Delete School ' + suffix, contract_disposable_password: 'Postman-' + suffix };",
              "Object.keys(values).forEach(key => { pm.collectionVariables.set(key, values[key]); pm.variables.set(key, values[key]); });",
