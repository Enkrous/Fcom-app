{
  "info": {
    "_postman_id": "fcom-api-contract-smoke-20261014",
    "name": "Fcom — Swift API Contract Smoke (local / disposable staging)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against local/disposable staging, or an explicitly authorized isolated production fixture namespace using the same seven-id/prefix guard as the main collection. Production requires allow_production_fixtures=true and test_environment=isolated-production-fixtures. Apply required repository migrations and deploy the repository Edge Functions with verify_jwt=false and custom JWT_SECRET. Set base_url; for a hosted disposable staging project explicitly set test_environment=disposable-staging. Supply a disposable approved caller and a same-school partner (local defaults bob/testpass and alice UUID). The collection reads messages, removes only caller-owned stale blocks, registers one unique pending account without phone/SMS, sets its password, verifies its identity, deletes ONLY that account and checks all captured tokens are revoked. No service-role or JWT signing secret is embedded; use only the generated fixture credentials. The original seed accounts are not deletion targets. Run all requests in order; do not stop between registration and deletion. A failed run may leave its dedicated postman_delete_* account for manual cleanup. This is a wire-contract smoke test; SQL suites cover transactional group transfer and retained media."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:54321/functions/v1"
    },
    {
      "key": "test_environment",
      "value": "local"
    },
    {
      "key": "smoke_nickname",
      "value": "bob"
    },
    {
      "key": "smoke_password",
      "value": "testpass"
    },
    {
      "key": "smoke_partner_id",
      "value": "00000000-0000-0000-0000-000000000001"
    },
    {
      "key": "smoke_stale_target_id",
      "value": "00000000-0000-0000-0000-000000000005"
    },
    {
      "key": "allow_production_fixtures",
      "value": "false"
    },
    {
      "key": "fcom_fixture_prefix",
      "value": ""
    },
    {
      "key": "fixture_user_ids",
      "value": "[]"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(() => {",
          "function abortRequest(message) {",
          "  pm.request.url.update('http://127.0.0.1:1/fcom-test-blocked');",
          "  if (pm.execution && typeof pm.execution.skipRequest === 'function') pm.execution.skipRequest();",
          "  throw new Error(message);",
          "}",
          "const mode = pm.variables.get('test_environment');",
          "const base = String(pm.variables.get('base_url') || '');",
          "const productionRun = mode === 'isolated-production-fixtures';",
          "if (!['local','disposable-staging','isolated-production-fixtures'].includes(mode)) abortRequest('Select local, disposable-staging or explicitly authorized isolated-production-fixtures.');",
          "const authority = (base.split('://')[1] || '').split('/')[0].toLowerCase();",
          "const hostname = authority.startsWith('[') ? authority.slice(0, authority.indexOf(']') + 1) : authority.split(':')[0];",
          "if (mode === 'local' && (!['http','https'].includes(base.split('://')[0]) || !['localhost','127.0.0.1','[::1]'].includes(hostname))) abortRequest('local mode requires a loopback URL.');",
          "if (mode !== 'local' && !base.startsWith('https://')) abortRequest('Hosted fixture tests require HTTPS.');",
          "const requestName = pm.info.requestName || '';",
          "const intentionalBadJwt = pm.request.method === 'GET' && (requestName.startsWith('S-03 ') || requestName.startsWith('S-05 '));",
          "if (/vzjlhiqvfgrrlfdgyebx/i.test(base) && !productionRun) abortRequest('Production requires isolated-production-fixtures and the explicit fixture flag.');",
          "if (productionRun) {",
          "  const prefix = pm.variables.get('fcom_fixture_prefix');",
          "  if (String(pm.variables.get('allow_production_fixtures')) !== 'true' || !/^postman_[a-f0-9]{12}$/.test(prefix || '')) abortRequest('Production tests require allow_production_fixtures=true and a newly generated postman_<12hex> prefix.');",
          "  let ids; try { ids = JSON.parse(pm.variables.get('fixture_user_ids')); } catch { abortRequest('fixture_user_ids must be the generated seven-id allowlist.'); }",
          "  if (!Array.isArray(ids) || ids.length !== 7 || new Set(ids).size !== 7 || ids.some(id => !/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(id) || /^00000000-0000-0000-0000-/.test(id))) abortRequest('Production fixture ids must be seven distinct newly generated UUIDs, never seed ids.');",
          "  ['alice','bob','carol','dave','eve','frank','grace'].forEach(name => { if (!ids.includes(pm.variables.get(name + '_id')) || !String(pm.variables.get(name + '_nickname')).startsWith(prefix + '_')) abortRequest('Every named actor must be an isolated fixture.'); });",
          "  const actualUrl = pm.variables.replaceIn(String(pm.request.url));",
          "  if (actualUrl.includes('/rest/v1/') && !String(pm.variables.get('supabase_url')).startsWith('https://')) abortRequest('Production PostgREST checks require the configured HTTPS fixture project.');",
          "  const captured = ['new_user_id','phone_user_id','first_school_user_id','reject_user_id'].map(key => pm.variables.get(key)).filter(Boolean);",
          "  const allowed = new Set(ids.concat(captured));",
          "  const auth = pm.variables.replaceIn(pm.request.headers.get('Authorization') || '');",
          "  if (auth.startsWith('Bearer ') && !String(pm.request.url).includes('/rest/v1/')) {",
          "    const jwtBuffer = require('buffer').Buffer; let subject; try { subject = JSON.parse(jwtBuffer.from(auth.slice(7).split('.')[1], 'base64').toString('utf8')).sub; } catch {}",
          "    if (!intentionalBadJwt && subject && !allowed.has(subject) && subject !== pm.collectionVariables.get('contract_disposable_id')) abortRequest('Bearer actor is outside the isolated fixture allowlist.');",
          "  }",
          "  let body; try { body = JSON.parse(pm.variables.replaceIn(pm.request.body && pm.request.body.raw || '{}')); } catch {}",
          "  if (body && !requestName.startsWith('SC-07 ') && !requestName.startsWith('SC-08 ')) {",
          "    if (body.groupId && (body.groupId !== pm.variables.get('group_id') || body.groupId !== pm.variables.get('group_fixture_verified'))) abortRequest('Group mutation must target the private group created and verified in this run.');",
          "    if (body.inviteId && ![pm.variables.get('bob_invite_id'),pm.variables.get('carol_invite_id')].includes(body.inviteId)) abortRequest('Invite mutation must target a captured fixture invite.');",
          "    if (body.reportId && body.reportId !== pm.variables.get('report_fixture_verified')) abortRequest('Report mutation must target the report created between fixture users.');",
          "    ['userId','targetId','toId','fromUserId','createdBy','invitedBy','invitedUserId','reporterId','blockerId','blockedId'].forEach(key => { if (body[key] && !allowed.has(body[key]) && body[key] !== pm.variables.get('missing_user_id') && body[key] !== pm.collectionVariables.get('contract_missing_id')) abortRequest('Mutation target is outside the isolated fixture allowlist.'); });",
          "    if (Array.isArray(body.memberIds) && body.memberIds.some(id => !allowed.has(id))) abortRequest('Group invitees must be fixture users.');",
          "    if (String(pm.request.url).includes('/register') && !String(pm.request.url).includes('/register-push') && ((body.nickname && !body.nickname.toLowerCase().startsWith(prefix + '_')) || (body.fullName && !body.fullName.toLowerCase().includes(prefix)))) abortRequest('Registration must use the generated fixture namespace.');",
          "    if (String(pm.request.url).includes('/verify-phone') || String(pm.request.url).includes('/resend-otp')) { const phones = ['new_phone','bob_phone','dave_phone','unknown_phone'].map(key => pm.variables.get(key)); if (!phones.includes(body.phone)) abortRequest('OTP requests must use fixture phone values.'); }",
          "  }",
          "}",
          "})();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "SC-01 Login a disposable approved fixture",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nickname\":\"{{smoke_nickname}}\",\"password\":\"{{smoke_password}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "['contract_token','contract_caller_id'].forEach(key => pm.collectionVariables.unset(key));",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('SC-01 HTTP 200 / ok', () => { pm.expect(pm.response.code).to.equal(200); pm.expect(r.ok).to.be.true; });",
              "pm.test('SC-01 approved caller and token', () => { pm.expect(r.user.status).to.equal('approved'); pm.expect(r.token).to.be.a('string').and.not.empty; });",
              "if (r.ok && r.token && r.user.status === 'approved') { pm.collectionVariables.set('contract_token', r.token); pm.collectionVariables.set('contract_caller_id', r.user.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "SC-02 Me returns server Credo",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contract_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "function abortRequest(message) {",
              "  pm.request.url.update('http://127.0.0.1:1/fcom-test-blocked');",
              "  if (pm.execution && typeof pm.execution.skipRequest === 'function') pm.execution.skipRequest();",
              "  throw new Error(message);",
              "}",
              "const capturedToken = pm.collectionVariables.get('contract_token');",
              "if (!capturedToken) abortRequest('Run this collection in order; no token was captured by its own setup.');",
              "pm.request.headers.upsert({key:'Authorization',value:'Bearer ' + capturedToken});",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('SC-02 HTTP 200 / ok', () => { pm.expect(pm.response.code).to.equal(200); pm.expect(r.ok).to.be.true; });",
              "function assertCredo(user) {",
              "  pm.expect(user.cred).to.be.a('number');",
              "  pm.expect(user.credLevel).to.be.an('object');",
              "  pm.expect(user.credLevel.name).to.be.a('string').and.not.empty;",
              "  pm.expect(user.credLevel.min).to.be.a('number');",
              "  pm.expect(user.credLevel.max === null || typeof user.credLevel.max === 'number').to.be.true;",
              "  pm.expect(['novice','known','trusted','own']).to.include(user.credLevel.css);",
              "  pm.expect(user.credProgress).to.be.a('number').and.within(0, 1);",
              "}",
              "pm.test('SC-02 server Credo', () => assertCredo(r.user));",
              "pm.test('SC-02 current identity', () => pm.expect(r.user.id).to.equal(pm.collectionVariables.get('contract_caller_id')));"
            ]
          }
        }
      ]
    },
    {
      "name": "SC-03 Directory eligibility snapshot",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/users",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contract_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "function abortRequest(message) {",
              "  pm.request.url.update('http://127.0.0.1:1/fcom-test-blocked');",
              "  if (pm.execution && typeof pm.execution.skipRequest === 'function') pm.execution.skipRequest();",
              "  throw new Error(message);",
              "}",
              "const capturedToken = pm.collectionVariables.get('contract_token');",
              "if (!capturedToken) abortRequest('Run this collection in order; no token was captured by its own setup.');",
              "pm.request.headers.upsert({key:'Authorization',value:'Bearer ' + capturedToken});",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "function assertCredo(user) {",
              "  pm.expect(user.cred).to.be.a('number');",
              "  pm.expect(user.credLevel).to.be.an('object');",
              "  pm.expect(user.credLevel.name).to.be.a('string').and.not.empty;",
              "  pm.expect(user.credLevel.min).to.be.a('number');",
              "  pm.expect(user.credLevel.max === null || typeof user.credLevel.max === 'number').to.be.true;",
              "  pm.expect(['novice','known','trusted','own']).to.include(user.credLevel.css);",
              "  pm.expect(user.credProgress).to.be.a('number').and.within(0, 1);",
              "}",
              "pm.test('Directory HTTP 200 and arrays', () => {",
              "  pm.expect(pm.response.code).to.equal(200);",
              "  pm.expect(r.ok).to.be.true;",
              "  ['users','pending','usersToRate'].forEach(key => pm.expect(r[key]).to.be.an('array'));",
              "});",
              "pm.test('Directory approved entries have server Credo and eligibility', () => {",
              "  r.users.forEach(user => {",
              "    assertCredo(user);",
              "    pm.expect(user.status).to.equal('approved');",
              "    pm.expect(user.phone).to.be.undefined;",
              "    pm.expect(user.canRate).to.be.an('object');",
              "    pm.expect(user.canRate.ok).to.be.a('boolean');",
              "    if (user.canRate.ok) pm.expect(user.canRate.reason).to.be.undefined;",
              "    else pm.expect(['no_chat','24h_limit']).to.include(user.canRate.reason);",
              "  });",
              "});",
              "pm.test('Directory pending entries have server Credo and no eligibility', () => {",
              "  r.pending.forEach(user => {",
              "    assertCredo(user);",
              "    pm.expect(user.status).to.equal('pending');",
              "    pm.expect(user.phone).to.be.undefined;",
              "    pm.expect(user.canRate).to.be.undefined;",
              "  });",
              "});",
              "pm.test('usersToRate equals eligible users in this response', () => {",
              "  const eligible = r.users.filter(user => user.canRate.ok).map(user => user.id).sort();",
              "  pm.expect(r.usersToRate.map(user => user.id).sort()).to.deep.equal(eligible);",
              "  r.usersToRate.forEach(user => {",
              "    assertCredo(user);",
              "    pm.expect(user.canRate.ok).to.be.true;",
              "    const listed = r.users.find(candidate => candidate.id === user.id);",
              "    pm.expect(user).to.deep.equal(listed);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
