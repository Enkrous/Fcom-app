              "pm.test('SC-08 newly generated pending identity/token', () => { pm.expect(r.user.status).to.equal('pending'); pm.expect(r.user.nickname).to.equal(pm.collectionVariables.get('contract_disposable_nickname')); pm.expect(r.user.fullName).to.equal(pm.collectionVariables.get('contract_disposable_name')); pm.expect(r.token).to.be.a('string').and.not.empty; });",
              "if (r.ok && r.token && r.user.nickname === pm.collectionVariables.get('contract_disposable_nickname')) { pm.collectionVariables.set('contract_disposable_id', r.user.id); pm.collectionVariables.set('contract_disposable_token', r.token); }"
