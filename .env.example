# Fcom — Environment Variables Template
#
# Copy this file to .env.local (git-ignored) and fill in real values.
# NEVER commit a file that contains real secrets.
#
# Where each variable is used:
#   Edge Functions read them via Deno.env.get('VAR_NAME')
#   Set them in: Supabase Dashboard → Settings → Edge Functions → Secrets
#
# ─── REQUIRED ─────────────────────────────────────────────────────────────────

# Custom JWT signing secret.
# Must be at least 32 characters. Used by all Edge Functions to sign and verify
# tokens. Change this immediately on any new environment — never share between
# dev and prod.
#
# Generate a safe value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   or: openssl rand -hex 48
JWT_SECRET=change_me_to_a_random_32_char_string_at_minimum

# Supabase project URL (public, safe to commit once decided)
# Example: https://abcdefghijkl.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key — NEVER expose to the browser.
# Used only inside Edge Functions to bypass RLS.
# Found in: Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── OPTIONAL — SMS (OTP delivery) ────────────────────────────────────────────

# If SMS_API_URL is empty or not set, the system runs in "dev OTP mode":
#   - OTP is returned in the API response as _devOtp
#   - Code "000000" is also accepted as a universal bypass
#
# Set both variables to enable real SMS delivery.

# Your SMS provider's HTTP endpoint (POST)
# Example for SMSAero: https://gate.smsaero.ru/v2/sms/send
SMS_API_URL=

# API key / Basic auth token for your SMS provider
SMS_API_KEY=

# ─── OPTIONAL — CORS ──────────────────────────────────────────────────────────

# Allowed origin for CORS responses. Defaults to "*" if not set.
# In production set this to your exact frontend domain:
#   ALLOWED_ORIGIN=https://fcom.example.com
ALLOWED_ORIGIN=*

# ─── LOCAL DEV ONLY ───────────────────────────────────────────────────────────
# These are for running Supabase locally with `supabase start`.
# Do NOT set these in production.

# Local Supabase API URL (default from `supabase start`)
# SUPABASE_URL=http://localhost:54321

# Local service_role key (printed by `supabase start`, safe for local use only)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...local_key...
